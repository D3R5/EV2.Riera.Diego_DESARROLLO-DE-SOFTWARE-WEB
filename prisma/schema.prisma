datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id        Int        @id @default(autoincrement())
  nombre    String
  correo    String     @unique
  clave     String
  proyectos Proyecto[]
}

model Proyecto {
  id           Int      @id @default(autoincrement())
  nombre       String
  fechaInicio  DateTime
  estado       String
  responsable  String
  monto        Float
  created_by   Int

  usuario      Usuario  @relation(fields: [created_by], references: [id])
}